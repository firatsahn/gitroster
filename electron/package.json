{
  "name": "gitroster-desktop",
  "version": "0.2.0",
  "description": "Desktop window for gitroster",
  "main": "main.js",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder"
  },
  "devDependencies": {
    "electron": "^44.7.0",
    "electron-builder": "^25.0.0"
  },
  "build": {
    "appId": "io.github.firatsahn.gitroster",
    "productName": "gitroster",
    "files": ["main.js", "package.json"],
    "extraResources": [{"from": "../gitroster", "to": "gitroster", "filter": ["**/*.py", "static/*"]}],
    "mac": {"category": "public.app-category.developer-tools"},
    "win": {"target": "nsis"},
    "linux": {"target": ["AppImage", "deb"], "category": "Development"}
  }
}
